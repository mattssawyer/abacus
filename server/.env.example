# Copy this file to server/.env and set your local values. Do not commit server/.env.
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
CLERK_FRONTEND_API_URL=

# These defaults match ../compose.yaml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/abacus
SPRING_DATASOURCE_USERNAME=abacus_app
SPRING_DATASOURCE_PASSWORD=abacus_app

# Generate a separate local Tink keyset; see ../docs/plaid-token-encryption.md. Paste JSON on one line.
PLAID_TOKEN_ENCRYPTION_KEYSET=

# Public HTTPS URL Plaid posts to. Leave empty for local-only sync-at-link.
# Example with ngrok: https://YOUR-SUBDOMAIN.ngrok-free.app/api/plaid/webhook
PLAID_WEBHOOK_URL=

# Sorts transactions into spending plan parts. Leave empty to skip sorting.
TYPESAFE_API_KEY=
